[15.766621, "o", "# Тестовый баланс для симуляции покупки\r\n\u001b[?2004l\r\u001b[?2004h"]
[15.767133, "o", "$ "]
[15.767429, "o", "uv run python -c 'from valutatrade_hub.core.usecases import TradingService; s=TradingService(); p=s.portfolios.load(); p[0][\"wallets\"]={\"USD\":{\"balance\":10000}}; s.portfolios.save(p)'"]
[15.768303, "o", "\r\n\u001b[?2004l\r"]
[15.947383, "o", "\u001b[?2004h$ uv run valutatrade\r\n\u001b[?2004l\r"]
